# Frontend (Cloudflare Pages) — Variáveis de ambiente públicas
# Copie para .env e preencha os valores.
# Segredos (CLERK_SECRET_KEY, DATABASE_URL, credenciais Rust ficam apenas no backend).

# Clerk — Publishable Key (pública, exposta no frontend)
# Obter em: https://dashboard.clerk.com -> API Keys -> Publishable key
# Começa com pk_test_ (dev) ou pk_live_ (produção).
VITE_CLERK_PUBLISHABLE_KEY=pk_live_xxxxxxxxxxxxx

# URL pública da API (backend no EasyPanel)
# Deve ter trailing slash removida, caminho base /api/v1
VITE_API_BASE_URL=https://app-armazem-backend.v22aau.easypanel.host/api/v1

# NÃO inclua aqui: CLERK_SECRET_KEY, DATABASE_URL, RUSTFS access keys,
# chaves privadas ou qualquer credencial de servidor.

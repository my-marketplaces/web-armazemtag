# Admin / Frontend - Variáveis de ambiente
# Copie para .env e preencha os valores.

# Clerk - Publishable Key (pública, pode estar no frontend)
# Obter em: https://dashboard.clerk.com -> API Keys
# Use a mesma instância Clerk configurada no backend (armazemtag-backend).
# A chave começa com pk_test_ (dev) ou pk_live_ (produção).
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxx

# API Base URL do backend publicado
VITE_API_BASE_URL=https://app-armazem-backend.v22aau.easypanel.host/api/v1

# Não coloque CLERK_SECRET_KEY, DATABASE_URL, R2 ou credenciais aqui.
# Segredos ficam apenas no servidor (backend).
